#include <behaviors/rgbled_widget.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

// Shortcuts for home row mods

#define DEF     0
#define SYM     1
#define NAV     2
#define NUM     3
#define FN      4
#define ADJ     5

&mt {
    flavor = "hold-preferred";
    quick-tap-ms = <200>;
};

&lt {
    flavor = "hold-preferred";
    quick-tap-ms = <200>;
};

// Sticky mods: released on the next key press, forgotten after 1.5 s
&sk {
    release-after-ms = <1500>;
    quick-release;
};

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";

        adj_layer {
            if-layers = <SYM NAV>;
            then-layer = <ADJ>;
        };

        fn_layer {
            if-layers = <NUM SYM>;
            then-layer = <FN>;
        };
    };

    behaviors {
        // Space / NAV: avoid accidental NAV during fast typing.
        // balanced: NAV only if another key is pressed AND released while Space is held.
        // require-prior-idle-ms: right after typing a letter, Space is always a tap.
        lt_spc: layer_tap_space {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <150>;
            bindings = <&mo>, <&kp>;
        };

        // Thumb: hold = Hyper (app switching), tap = one-shot Ctrl (Ctrl+C/D/L/S)
        hyp: hyper_or_sticky_ctrl {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            bindings = <&kp>, <&sk>;
        };

        // Layer mods: hold = ordinary mod (for arrows/digits), tap = one-shot mod
        // for the next key after the layer is released
        smod: sticky_or_hold_mod {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&kp>, <&sk>;
        };

        cmd_on: cmd_on {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp LGUI>;
        };

        cmd_off: cmd_off {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_release &kp LGUI>;
        };

        opt_on: opt_on {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp LALT>;
        };

        opt_off: opt_off {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_release &kp LALT>;
        };

        app_next: app_next {
            compatible = "zmk,behavior-tri-state";
            #binding-cells = <0>;
            bindings = <&cmd_on>, <&kp TAB>, <&cmd_off>;
            ignored-key-positions = <27>;
        };

        app_prev: app_prev {
            compatible = "zmk,behavior-tri-state";
            #binding-cells = <0>;
            bindings = <&cmd_on>, <&kp LS(TAB)>, <&cmd_off>;
            ignored-key-positions = <29>;
        };

        win_next: win_next {
            compatible = "zmk,behavior-tri-state";
            #binding-cells = <0>;
            bindings = <&opt_on>, <&kp TAB>, <&opt_off>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default {
            label = "DEFAULT";
            display-name = "DEFAULT";
            bindings = <
           &mt LSHFT GRAVE                                                                                                                                                   &kp RALT
&kp NUBS   &kp Q           &kp W  &kp E  &kp R  &kp T                   &kp Y    &kp U  &kp I      &kp O    &kp P           &kp SQT
&kp BSLH   &kp A           &kp S  &kp D  &kp F  &kp G                   &kp H    &kp J  &kp K      &kp L    &kp SEMI        &kp LBKT
           &kp Z           &kp X  &kp C  &kp V  &kp B                   &kp N    &kp M  &kp COMMA  &kp DOT  &kp SLASH
                     &lt NUM BSPC  &mt LSHFT TAB  &mt LGUI ESC  &lt SYM RET  &lt_spc NAV SPACE  &hyp LS(LA(LC(LGUI))) LCTRL
            >;
        };

        symbol {
            label = "SYMBOLS";
            display-name = "SYMBOLS";
            bindings = <
           &kp LGUI                                                                                                                   &kp RGUI
&kp LCTRL  &kp AT     &kp PLUS  &kp LBKT  &kp RBKT  &kp CARET                                      &kp DLLR   &none     &none  &none  &none     &kp RCTRL
&kp LALT   &kp MINUS  &kp EQUAL &kp LPAR  &kp RPAR  &kp STAR                                       &kp PRCNT  &kp EXCL  &none  &none  &kp RALT  &kp RBKT
           &kp AMPS   &kp HASH  &kp LBRC  &kp RBRC  &kp UNDER                                      &kp NUHS   &kp LG(MINUS) &kp LG(N0) &kp LG(EQUAL) &none
                                                    &trans     &kp LSHFT  &kp ESC  &trans  &trans  &trans
            >;
        };

        navigation {
            label = "NAV";
            display-name = "NAV";
            bindings = <
                              &none                                                                                                                                                                                        &none
&kp LS(LA(LC(LG(NUMBER_3))))  &kp GLOBE  &kp PG_UP  &kp LG(LC(V))  &kp LG(LEFT)   &kp LS(LA(LC(LG(BSLH))))                                &kp LS(LA(LC(LG(BSLH)))) &kp F1                 &kp F2    &kp LG(LS(A))              &kp LS(LA(LC(LG(SQT)))) &kp LS(LA(LC(LG(NUMBER_2))))
&kp LS(LA(LC(LG(NUMBER_4))))  &kp INS    &kp LEFT   &kp UP         &kp RIGHT      &kp LG(SPACE)                                           &sk LS(LGUI)          &smod RGUI RGUI           &smod LALT LALT  &smod RSHFT RSHFT   &smod RCTRL RCTRL       &kp LS(LA(LC(LG(NUMBER_1))))
                              &kp DEL    &kp PG_DN  &kp DOWN       &kp LG(RIGHT)  &kp ESC                                                 &none                 &kp LS(LG(LEFT_BRACKET))  &smod LALT LALT  &kp LS(LG(RIGHT_BRACKET))  &kp LG(SPACE)
                                                                              &kp BSPC              &kp TAB  &kp RET  &trans  &trans  &trans
            >;
        };

        number {
            label = "NUMBERS";
            display-name = "NUMBERS";
            bindings = <
       &none                                                                                                                                                                          &none
&none  &none              &kp LC(LS(TAB))        &kp LG(LC(V))    &kp LC(TAB)       &none                                   &kp KP_SLASH     &kp N7  &kp N8  &kp N9  &kp KP_MINUS  &none
&none  &smod LCTRL LCTRL  &smod LSHFT LSHFT      &smod LALT LALT  &smod LGUI LGUI   &kp HOME                                &kp KP_MULTIPLY  &kp N4  &kp N5  &kp N6  &kp KP_PLUS   &none
       &kp LG(SPACE)      &app_prev              &win_next        &app_next         &kp END                                 &kp KP_DOT       &kp N1  &kp N2  &kp N3  &kp DOT
                                                                              &kp BSPC  &trans  &trans             &kp KP_ENTER  &kp N0 &kp COMMA
            >;
        };

        fn {
            label = "FN KEYS";
            display-name = "FN KEYS";
            bindings = <
       &none                                                                                                                            &none
&none  &kp F1  &kp F2   &kp F3   &kp F4   &none                                       &none      &kp PAUSE_BREAK   &kp SLCK     &kp KP_NUM  &kp CAPS      &none
&none  &kp F5  &kp F6   &kp F7   &kp F8   &none                                       &kp GLOBE  &smod RGUI RGUI   &smod LALT LALT  &smod RSHFT RSHFT  &smod RCTRL RCTRL  &none
       &kp F9  &kp F10  &kp F11  &kp F12  &none                                       &none      &kp PAUSE_BREAK   &smod LALT LALT  &kp KP_NUM  &kp CAPS
                                          &kp BSPC  &kp TAB  &kp ESC  &trans  &trans  &trans
            >;
        };

        adjust {
            label = "ADJUST";
            display-name = "ADJUST";
            bindings = <
       &bootloader                                                                                                                               &bootloader
&none  &kp C_MUTE    &none         &none         &none         &kp C_VOL_UP                                  &ind_con    &ind_bat  &none  &none  &none        &studio_unlock
&none  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                                  &bt BT_CLR  &none     &none  &none  &none        &none
       &kp C_STOP    &kp C_PP      &kp C_PREV    &kp C_NEXT    &kp C_VOL_DN                                  &none       &none     &none  &none  &none
                                                               &trans        &trans  &trans  &trans  &trans  &trans
            >;
        };

        // Extra empty layers for ZMK Studio

        layer6 { status = "reserved"; };

        layer7 { status = "reserved"; };

        layer8 { status = "reserved"; };

        layer9 { status = "reserved"; };

        layer10 { status = "reserved"; };

        layer11 { status = "reserved"; };

        layer12 { status = "reserved"; };

        layer13 { status = "reserved"; };

        layer14 { status = "reserved"; };

        layer15 { status = "reserved"; };
    };
};

// vim: expandtab softtabstop=4 shiftwidth=4 filetype=dts
